# Resend — booking request emails (optional in dev; required to actually send)
# Get a key at https://resend.com and verify your sending domain.
RESEND_API_KEY=re_your_api_key

# From address must be on a domain verified in Resend.
RESEND_FROM=Top Tier Motorworks <service@toptiermotorworks.ca>

# Where new booking requests are emailed (comma-separated for multiple).
# Defaults to the shop email in src/shop.ts when unset.
BOOKING_NOTIFY_TO=service@toptiermotorworks.ca
